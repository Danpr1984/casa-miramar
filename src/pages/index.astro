---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Carousel from "../components/Carousel.astro";
import imgHero from "../assets/images/hero-miramar.jpg";
import imgCta from "../assets/images/cta-miramar.jpg";

/* =========================================================
   CONTENIDO EDITABLE — cambia aquí los textos y números.
   No necesitas tocar el HTML de abajo para actualizar el sitio.
   ========================================================= */
const content = {
  hero: {
    title: "Casa Miramar",
    subtitle: "Tu escape frente al mar, en el corazón de la costa.",
    cta: "Reservar ahora",
  },
  intro: {
    stats: [
      { value: "8", label: "Huéspedes" },
      { value: "2 min", label: "Acceso al mar" },
      { value: "Sí", label: "Piscina privada" },
      { value: "20 min", label: "A la ciudad" },
    ],
    paragraph:
      "Casa Miramar combina diseño cálido y vistas al océano para una estadía inolvidable. Espacios amplios, luz natural y detalles pensados para que descanses de verdad — ideal para familias y grupos de amigos.",
  },
  split: {
    label: "La Casa",
    heading: "Un refugio diseñado para desconectar",
    text: "Cada rincón de Casa Miramar fue pensado para la calma: espacios abiertos que conectan interior y exterior, materiales naturales y una paleta serena que deja que el paisaje sea protagonista. Sala, comedor y cocina integrados se abren hacia la terraza y la piscina.",
    images: [
      "/images/miramar/casa-1.jpg",
      "/images/miramar/casa-2.jpg",
      "/images/miramar/casa-3.jpg",
    ],
  },
  rooms: [
    {
      title: "Habitaciones",
      alt: "Habitación Casa Miramar",
      images: [
        "/images/miramar/hab-1.jpg",
        "/images/miramar/hab-2.jpg",
        "/images/miramar/hab-3.jpg",
      ],
    },
    {
      title: "Espacios Comunes",
      alt: "Espacios comunes Casa Miramar",
      images: [
        "/images/miramar/comun-1.jpg",
        "/images/miramar/comun-2.jpg",
        "/images/miramar/comun-3.jpg",
      ],
    },
    {
      title: "Jardín y Piscina",
      alt: "Jardín y piscina Casa Miramar",
      images: [
        "/images/miramar/piscina-1.jpg",
        "/images/miramar/piscina-2.jpg",
        "/images/miramar/piscina-3.jpg",
      ],
    },
  ],
  amenities: {
    label: "Amenidades",
    heading: "Casa Miramar incluye",
    items: [
      { icon: "🛜", title: "Wifi de alta velocidad", desc: "Internet rápido en toda la casa." },
      { icon: "❄️", title: "Aire acondicionado", desc: "En todas las habitaciones." },
      { icon: "🍳", title: "Cocina equipada", desc: "Todo lo necesario para cocinar." },
      { icon: "🚗", title: "Parqueo privado", desc: "Espacio seguro para varios vehículos." },
      { icon: "🏊", title: "Piscina privada", desc: "Abierta todo el día para huéspedes." },
      { icon: "🧺", title: "Lavandería", desc: "Lavadora disponible en la propiedad." },
      { icon: "🔥", title: "Zona de fogata", desc: "Ideal para noches al aire libre." },
      { icon: "🛎️", title: "Atención personalizada", desc: "Equipo disponible durante tu estadía." },
    ],
  },
  experience: {
    label: "Experiencia",
    heading: "Vive la costa a tu manera",
    photos: [
      { src: "/images/miramar/exp-playa.jpg", caption: "Playa" },
      { src: "/images/miramar/exp-naturaleza.jpg", caption: "Naturaleza" },
      { src: "/images/miramar/exp-atardecer.jpg", caption: "Atardeceres" },
      { src: "/images/miramar/exp-zona.jpg", caption: "La zona" },
    ],
  },
  location: {
    label: "Ubicación",
    heading: "Cerca de todo lo importante",
    pills: [
      "🏖️ Playa — 2 min caminando",
      "🍽️ Restaurantes — 5 min",
      "🛒 Supermercado — 10 min",
      "🏙️ Centro de la ciudad — 20 min",
      "✈️ Aeropuerto — 45 min",
    ],
  },
  rules: {
    label: "Reglas de la Casa",
    heading: "Para una buena estadía",
    items: [
      "Check-in: 3:00 PM · Check-out: 11:00 AM",
      "No se permite fumar dentro de la casa",
      "Mascotas bienvenidas previa coordinación",
      "Máximo de huéspedes según reserva",
      "Se solicita respetar el horario de silencio después de las 10:00 PM",
    ],
    contactText: "¿Dudas antes de reservar? Escríbenos por WhatsApp.",
    whatsappNumber: "+505 0000 0000",
    whatsappLink: "https://wa.me/50500000000",
  },
  ctaSection: {
    heading: "Tu próxima escapada empieza aquí",
    button: "Reservar ahora",
  },
};
---

<BaseLayout
  title="Casa Miramar — Alquiler vacacional frente al mar"
  description="Casa Miramar: alquiler vacacional frente al mar con piscina privada, 8 huéspedes y acceso directo a la playa."
  lang="es"
>
  <Nav lang="es" />

  <!-- HERO -->
  <section class="hero">
    <Image src={imgHero} alt="Casa Miramar" width={1920} height={1080} loading="eager" class="hero-img" />
    <div class="hero-overlay"></div>
    <div class="hero-content container">
      <h1>{content.hero.title}</h1>
      <p class="hero-subtitle">{content.hero.subtitle}</p>
      <a href="#reservar" class="btn btn-outline">{content.hero.cta}</a>
    </div>
  </section>

  <!-- INTRO -->
  <section class="intro container" id="casa">
    <div class="intro-stats">
      {content.intro.stats.map((s) => (
        <div class="stat">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
    <p class="intro-text">{content.intro.paragraph}</p>
  </section>

  <!-- SPLIT -->
  <section class="split">
    <div class="container split-inner">
      <div class="split-text">
        <span class="section-label">{content.split.label}</span>
        <h2>{content.split.heading}</h2>
        <p>{content.split.text}</p>
      </div>
      <div class="split-carousel">
        <Carousel images={content.split.images} id="carousel-house" alt="Casa Miramar" aspectRatio="4/3" />
      </div>
    </div>
  </section>

  <!-- ROOMS -->
  <section class="rooms container" id="habitaciones">
    <span class="section-label">Habitaciones</span>
    <h2 class="rooms-heading">Espacios para cada momento</h2>
    <div class="rooms-grid">
      {content.rooms.map((room, i) => (
        <div class="room-card">
          <Carousel images={room.images} id={`carousel-room-${i}`} alt={room.alt} aspectRatio="4/3" />
          <h3>{room.title}</h3>
        </div>
      ))}
    </div>
  </section>

  <!-- AMENITIES -->
  <section class="amenities" id="amenidades">
    <div class="container">
      <span class="section-label">{content.amenities.label}</span>
      <h2 class="amenities-heading">{content.amenities.heading}</h2>
      <div class="amenities-grid">
        {content.amenities.items.map((item) => (
          <div class="amenity">
            <span class="amenity-icon">{item.icon}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section class="experience container">
    <span class="section-label">{content.experience.label}</span>
    <h2 class="experience-heading">{content.experience.heading}</h2>
    <div class="experience-grid">
      {content.experience.photos.map((p) => (
        <div class="experience-item">
          <img src={p.src} alt={p.caption} loading="lazy" />
          <span>{p.caption}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- LOCATION -->
  <section class="location" id="ubicacion">
    <div class="container">
      <span class="section-label">{content.location.label}</span>
      <h2 class="location-heading">{content.location.heading}</h2>
      <div class="location-pills">
        {content.location.pills.map((pill) => (
          <span class="pill">{pill}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- HOUSE RULES -->
  <section class="rules container">
    <span class="section-label">{content.rules.label}</span>
    <h2 class="rules-heading">{content.rules.heading}</h2>
    <ul class="rules-list">
      {content.rules.items.map((rule) => (
        <li>{rule}</li>
      ))}
    </ul>
    <p class="rules-contact">
      {content.rules.contactText}
      <a href={content.rules.whatsappLink} target="_blank" rel="noopener" class="rules-whatsapp">
        {content.rules.whatsappNumber}
      </a>
    </p>
  </section>

  <!-- CTA -->
  <section class="cta-section" id="reservar">
    <Image src={imgCta} alt="Reserva Casa Miramar" width={1920} height={900} class="cta-img" />
    <div class="cta-overlay"></div>
    <div class="cta-content container">
      <h2>{content.ctaSection.heading}</h2>
      <a href={content.rules.whatsappLink} target="_blank" rel="noopener" class="btn btn-outline">
        {content.ctaSection.button}
      </a>
    </div>
  </section>

  <Footer lang="es" />
</BaseLayout>

<style>
  /* HERO */
  .hero { position: relative; height: 100svh; min-height: 560px; overflow: hidden; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(28,28,28,0.35) 0%, rgba(28,28,28,0.15) 40%, rgba(28,28,28,0.55) 100%);
  }
  .hero-content {
    position: relative; z-index: 2;
    height: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; color: var(--white);
    gap: 18px;
  }
  .hero-content h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); }
  .hero-subtitle { font-size: 1.1rem; max-width: 40ch; font-weight: 300; opacity: 0.95; }

  /* INTRO */
  .intro { padding: 88px 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .intro-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .stat { display: flex; flex-direction: column; gap: 4px; }
  .stat-value { font-family: 'Cormorant Garamond', serif; font-size: 2.4rem; font-weight: 600; color: var(--accent-dk); }
  .stat-label { font-size: 0.78rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
  .intro-text { color: var(--muted); font-size: 1.02rem; }

  /* SPLIT */
  .split { background: var(--bg-sand); padding: 96px 0; }
  .split-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .split-text h2 { font-size: 2.2rem; margin: 10px 0 18px; }
  .split-text p { color: var(--muted); }
  .split-carousel { border-radius: 4px; overflow: hidden; }

  /* ROOMS */
  .rooms { padding: 96px 32px; text-align: center; }
  .rooms-heading { font-size: 2.2rem; margin: 10px 0 44px; }
  .rooms-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; text-align: left; }
  .room-card { border: 1px solid var(--border); border-radius: 4px; overflow: hidden; background: var(--bg-card); }
  .room-card h3 { padding: 18px 20px; font-size: 1.35rem; }

  /* AMENITIES */
  .amenities { background: var(--bg-sand); padding: 96px 32px; text-align: center; }
  .amenities-heading { font-size: 2.2rem; margin: 10px 0 48px; }
  .amenities-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; text-align: left; }
  .amenity-icon { font-size: 1.8rem; display: block; margin-bottom: 12px; }
  .amenity h3 { font-size: 1.15rem; font-weight: 500; margin-bottom: 6px; font-family: 'Jost', sans-serif; }
  .amenity p { color: var(--muted); font-size: 0.92rem; }

  /* EXPERIENCE */
  .experience { padding: 96px 32px; text-align: center; }
  .experience-heading { font-size: 2.2rem; margin: 10px 0 44px; }
  .experience-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .experience-item { position: relative; border-radius: 4px; overflow: hidden; aspect-ratio: 4/3; }
  .experience-item img { width: 100%; height: 100%; object-fit: cover; }
  .experience-item span {
    position: absolute; bottom: 14px; left: 16px; color: var(--white);
    font-family: 'Cormorant Garamond', serif; font-size: 1.3rem;
    text-shadow: 0 1px 6px rgba(0,0,0,0.5);
  }

  /* LOCATION */
  .location { background: var(--bg-sand); padding: 88px 32px; text-align: center; }
  .location-heading { font-size: 2.2rem; margin: 10px 0 36px; }
  .location-pills { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .pill {
    border: 1px solid var(--border); background: var(--bg-card);
    padding: 10px 20px; border-radius: 999px; font-size: 0.88rem; color: var(--text);
  }

  /* RULES */
  .rules { padding: 96px 32px; max-width: 780px; }
  .rules-heading { font-size: 2.2rem; margin: 10px 0 28px; }
  .rules-list { display: flex; flex-direction: column; gap: 12px; padding-left: 22px; color: var(--muted); }
  .rules-list li { list-style: disc; }
  .rules-contact { margin-top: 32px; font-size: 0.98rem; }
  .rules-whatsapp { color: var(--accent-dk); font-weight: 500; margin-left: 6px; border-bottom: 1px solid var(--accent-dk); }

  /* CTA */
  .cta-section { position: relative; padding: 140px 32px; text-align: center; overflow: hidden; }
  .cta-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .cta-overlay { position: absolute; inset: 0; background: rgba(28,28,28,0.55); z-index: 1; }
  .cta-content { position: relative; z-index: 2; color: var(--white); display: flex; flex-direction: column; align-items: center; gap: 26px; }
  .cta-content h2 { font-size: clamp(2rem, 4vw, 2.8rem); max-width: 20ch; }

  @media (max-width: 860px) {
    .intro { grid-template-columns: 1fr; gap: 36px; padding: 64px 20px; }
    .intro-stats { grid-template-columns: repeat(2, 1fr); }
    .split-inner { grid-template-columns: 1fr; gap: 36px; }
    .rooms, .amenities, .experience, .location, .rules, .cta-section { padding-left: 20px; padding-right: 20px; }
    .rooms-grid, .amenities-grid { grid-template-columns: 1fr 1fr; }
    .experience-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .rooms-grid, .amenities-grid { grid-template-columns: 1fr; }
  }
</style>
